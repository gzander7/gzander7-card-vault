{
  "compilerOptions": {
    "target": "es2022",
    "module": "esnext",
    "moduleResolution": "bundler",
    "lib": ["es2023", "dom", "dom.iterable", "webworker.importscripts"],
    "allowJs": true,
    "checkJs": true,
    "noEmit": true,
    "strict": false,
    "skipLibCheck": true,
    "types": ["node"]
  },
  "include": [
    "*.js",
    "*.mjs",
    "display/**/*",
    "photos/**/*",
    "pricing/**/*",
    "scanning/**/*",
    "vendor/*.d.mts",
    "types/*.d.ts"
  ],
  "exclude": [
    "node_modules",
    "vendor/**/*.mjs",
    "vendor/tesseract",
    "e2e",
    "supabase/functions",
    "**/*.test.mjs",
    "**/*.test.mjs",
    "sw.js"
  ]
}
