{
  "name": "card-vault",
  "version": "1.0.0",
  "private": true,
  "description": "Gage's trading card collection, served as static files from GitHub Pages with Supabase as the backend.",
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "start": "node scripts/serve.mjs",
    "test": "node --test \"**/*.test.mjs\"",
    "test:e2e": "playwright test --trace off",
    "test:db": "bash scripts/test-db.sh",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc -p tsconfig.json",
    "check": "npm run lint && npm run format:check && npm run typecheck && npm test",
    "vendor": "node scripts/vendor.mjs",
    "sync:functions": "node scripts/sync-function-shared.mjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "10.0.1",
    "@playwright/test": "1.63.0",
    "@supabase/supabase-js": "2.119.0",
    "@tesseract.js-data/eng": "1.0.0",
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "tesseract.js": "7.0.0",
    "tesseract.js-core": "7.0.0",
    "typescript": "7.0.2"
  }
}
